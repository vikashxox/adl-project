rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Loan proof images uploaded by authenticated beneficiaries ──────────
    // Path: loan_proofs/{beneficiaryDocId}/{fileName}
    match /loan_proofs/{allPaths=**} {
      // Any signed-in user can upload and read proof images.
      // Tighten this further (e.g. request.auth.uid == userId) once you
      // store the uploader UID in the file path.
      allow read, write: if request.auth != null;
    }

    // ── Legacy uploads bucket (ConnectivityService auto-sync) ─────────────
    match /uploads/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // ── Deny everything else ──────────────────────────────────────────────
    match /{everything=**} {
      allow read, write: if false;
    }
  }
}
